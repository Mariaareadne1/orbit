{
  "name": "orbit",
  "private": true,
  "version": "0.1.0",
  "description": "Spatial audio choreography: positions on a soundstage drive real Web Audio HRTF panning. Starts with a measured DSP proof.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 5431 --strictPort",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.64.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "ffprobe-static": "3.1.0",
    "globals": "^17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
